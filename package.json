{
  "name": "dsh-zmtgzt",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin that brings the Easel social-content agent into dsh. Bundles an Easel snapshot (114 skills plus the SOUL.md / AGENTS.md contract) so no clone is required, releasing it to a writable workspace on first run. Registers 23 zmtgzt_* tools for contract and skill reading, script execution, and manifest/profile/topic state, and adds a Creator Workbench (自媒体工作台) entry to the sidebar via the official sidebar.panellist + main two-stage registration.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "vendor/easel",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "scripts/sync-easel.mjs",
    "README.md",
    "README.zh-CN.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "easel",
    "content-orchestration",
    "social-media"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "workbench": "node scripts/workbench.mjs",
    "ui": "node scripts/ui-entry.mjs",
    "verify:real": "node scripts/verify-real-data.mjs",
    "sync:easel": "node scripts/sync-easel.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
